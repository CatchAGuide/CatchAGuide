APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_SLACK_WEBHOOK_URL=
LOG_STDERR_FORMATTER=
PAPERTRAIL_URL=
PAPERTRAIL_PORT=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DB_FOREIGN_KEYS=true
DATABASE_URL=
MYSQL_ATTR_SSL_CA=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_PREFIX=
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_CONNECTION=
SESSION_STORE=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
SESSION_COOKIE=

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_PERSISTENT_ID=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_CLUSTER=redis
REDIS_PREFIX=
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOG_CHANNEL=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"
MAIL_ADMIN_EMAIL=

# Optional mail drivers (when MAIL_MAILER=mailgun / postmark)
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
POSTMARK_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SQS queue (when QUEUE_CONNECTION=sqs)
SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
SQS_QUEUE=default
SQS_SUFFIX=

# DigitalOcean Spaces (S3-compatible object storage)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=catchaguide-assets
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_URL=https://catchaguide-assets.fra1.cdn.digitaloceanspaces.com
DO_SPACES_USE_PATH_STYLE_ENDPOINT=false

# Media storage (set MEDIA_STORAGE_DISK=public for local-only dev without DO)
MEDIA_STORAGE_DISK=do_spaces
MEDIA_STORAGE_LOCAL_DISK=public
# Optional: force CDN folder (production|staging). Empty = derived from APP_ENV (local → staging)
# MEDIA_BUCKET_PREFIX=production
# Build CDN URLs without S3 HEAD calls (recommended for PageSpeed)
MEDIA_URL_SKIP_EXISTS=true
# Cache backend exists checks for read/move/delete (seconds; 0 = disabled)
MEDIA_EXISTS_CACHE_TTL=86400
# public = browser-accessible URLs on DO Spaces (public-read ACL)
MEDIA_OBJECT_VISIBILITY=public

# Bulk sync local folders to DO (run on production server — see media:sync-directories)
# php artisan media:sync-directories --from-listing-media --prefix=production --skip-existing

# Site asset storage helper (config/cag.php)
SITE_STORAGE=local
SITE_KEY=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
ABLY_KEY=

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

STRIPE_KEY=""
STRIPE_SECRET=""
CASHIER_CURRENCY=eur

TO_MAIL=info@catchaguide.com
CC_MAIL=info@catchaguide.com
# New guide applications are emailed to TO_CEO (override with GUIDE_ADMIN_NOTIFICATION_EMAIL if needed)
TO_CEO=info@catchaguide.com
GUIDE_ADMIN_NOTIFICATION_EMAIL=

PRICE_CAT_0=0
PRICE_CAT_1=350
PRICE_CAT_2=1500

PRICE_CAT_0_FEE=0.10
PRICE_CAT_1_FEE=0.075
PRICE_CAT_2_FEE=0.003

# Finance / invoices
FINANCE_TAX_RATE=0.19
FINANCE_INVOICE_DUE_DAYS=10
FINANCE_COMMISSION_MAX_RATIO_OF_GROSS=0.5

# Guide onboarding
NEW_ONBOARDING_ENABLED=true
GUIDE_COMPANY_ONBOARDING_ENABLED=false
EMAIL_VERIFICATION_ENABLED=false

# Public booking assistant (Groq — separate from Gemini translation)
BOOKING_ASSISTANT_ENABLED=false
BOOKING_ASSISTANT_WIDGET_VISIBLE=false

# Dynamic Terms & Conditions CMS (/agb). Keep false until admin content is ready.
DYNAMIC_TERMS_ENABLED=false
BOOKING_ASSISTANT_PREVIEW_TOKEN=
BOOKING_ASSISTANT_PREVIEW_PATH=hub/cag-ba-preview
BOOKING_ASSISTANT_DRIVER=groq
BOOKING_ASSISTANT_GROQ_API_KEY=
BOOKING_ASSISTANT_GROQ_BASE_URL=https://api.groq.com/openai/v1
BOOKING_ASSISTANT_GROQ_MODEL=llama-3.1-8b-instant
BOOKING_ASSISTANT_MAX_OUTPUT_TOKENS=512
BOOKING_ASSISTANT_MAX_MESSAGES=16
BOOKING_ASSISTANT_MAX_TOOL_ITERATIONS=3
BOOKING_ASSISTANT_MAX_TOOL_ROWS=8
BOOKING_ASSISTANT_TEMPERATURE=0.4
BOOKING_ASSISTANT_HTTP_TIMEOUT=45
BOOKING_ASSISTANT_RATE_PER_MINUTE=15

# Site contact (shown in header/footer JSON-LD and phone links)
CONTACT_NUM=

# Cookie consent banner
COOKIE_CONSENT_ENABLED=true

# Google reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SKIP_IP=

# Google Maps (required for maps, geocoding, Places autocomplete)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_LOCALE=us
MAPS_ENGINE=leaflet
MAPS_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAPS_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
MAPS_DEFAULT_LAT=51.165691
MAPS_DEFAULT_LNG=10.451526
MAPS_DEFAULT_ZOOM=5

# Location search / resolver
LOCATION_SEARCH_CITY_RADIUS_KM=20
LOCATION_SEARCH_REGION_RADIUS_KM=80
LOCATION_SEARCH_COUNTRY_RADIUS_KM=120
LOCATION_SEARCH_NEARBY_MAX_MAIN_RESULTS=12
LOCATION_SEARCH_ENFORCE_COUNTRY=true
LOCATION_RESOLVER_GOOGLE_FALLBACK=false

# Google Gemini (translation / AI features)
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
TRANSLATION_SERVICE=gemini

# Gemini rate limits / reliability
GEMINI_RATE_LIMIT_PER_MINUTE=10
GEMINI_RATE_LIMIT_PER_HOUR=100
GEMINI_RATE_LIMIT_PER_DAY=500
GEMINI_MAX_INPUT_LENGTH=500
GEMINI_MIN_INPUT_LENGTH=2
GEMINI_MAX_FAILURES=5
GEMINI_CIRCUIT_OPEN_DURATION=300
GEMINI_CACHE_TTL=86400
GEMINI_CACHE_PREFIX=gemini_translation_
GEMINI_QUEUE_ENABLED=true
GEMINI_QUEUE_MAX_SIZE=100
GEMINI_QUEUE_BATCH_SIZE=5
GEMINI_QUEUE_PROCESS_INTERVAL=10
GEMINI_DAILY_USAGE_THRESHOLD=1000
GEMINI_LOG_CHANNEL=gemini_usage
GEMINI_ENABLE_COST_TRACKING=true
GEMINI_ENABLE_IP_BLOCKING=true
GEMINI_MAX_VIOLATIONS_BEFORE_BLOCK=3
GEMINI_BLOCK_DURATION=3600
GEMINI_ENABLE_PATTERN_DETECTION=true

# Vacations / trips
VACATION_TRIP_LEGAL_SELLER=

# Locale-specific public URLs (hreflang, canonicals)
EN_APP_URL=https://www.catchaguide.com
DE_APP_URL=https://www.catchaguide.de

# Sanctum / hashing / views (usually leave defaults)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
BCRYPT_ROUNDS=10
VIEW_COMPILED_PATH=

# Optional DynamoDB cache driver
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=
